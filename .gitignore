# Credentials & secrets
.env

# Device config (contains hardware MAC addresses / device IDs — personal data)
# Copy config/go2rtc.yaml.example → config/go2rtc.yaml and fill in your device IDs
config/go2rtc.yaml

# Local Compose changes (NAS paths, extra ports …) — see docker-compose.override.yml.example
docker-compose.override.yml

# Runtime data (created automatically on first run)
data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
webapp/frontend/node_modules/
webapp/frontend/dist/
# The Docker build uses `npm ci`, so package-lock.json is the lockfile of record.
# A second one from a local bun install would only drift.
webapp/frontend/bun.lock

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Documentation site (VitePress)
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
